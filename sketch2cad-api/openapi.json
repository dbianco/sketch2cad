          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "created_by": {
            "format": "uuid",
            "title": "Created By",
            "type": "string"
          },
          "declared_location": {
            "title": "Declared Location",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "incident_date": {
            "format": "date",
            "title": "Incident Date",
            "type": "string"
          },
          "incident_type": {
            "$ref": "#/components/schemas/IncidentType"
          },
          "organization": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Organization"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "code",
          "incident_type",
          "incident_date",
          "description",
          "declared_location",
          "organization",
          "status",
          "created_by",
          "created_at"
        ],
        "title": "CaseFileOut",
        "type": "object"
      },
      "CaseMemberCreate": {
        "properties": {
          "permissions": {
            "items": {
              "$ref": "#/components/schemas/CasePermission"
            },
            "minItems": 1,
            "title": "Permissions",
            "type": "array"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "permissions"
        ],
        "title": "CaseMemberCreate",
        "type": "object"
      },
      "CaseMemberOut": {
        "properties": {
          "case_file_id": {
            "format": "uuid",
            "title": "Case File Id",
            "type": "string"
          },
          "permissions": {
            "items": {
              "$ref": "#/components/schemas/CasePermission"
            },
            "title": "Permissions",
            "type": "array"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "case_file_id",
          "user_id",
          "permissions"
        ],
        "title": "CaseMemberOut",
        "type": "object"
      },
      "CasePermission": {
        "description": "Permissions stored in ``case_member.permissions``.",
        "enum": [
          "read",
          "edit",
          "deliver"
        ],
        "title": "CasePermission",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IncidentType": {
        "description": "Kind of incident; stored as the PostgreSQL enum ``incident_type``.",
        "enum": [
          "traffic_collision",
          "crime_scene",
          "inspection",
          "other"
        ],
        "title": "IncidentType",
        "type": "string"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "title": "Password",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "UserEnvelope": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
