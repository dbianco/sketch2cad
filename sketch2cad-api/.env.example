DATABASE_URL=
SESSION_SECRET=
SIGNING_KEY_PATH=
APP_ENV=

# docker compose only (docker-compose.yml). Copy this file to .env (never committed)
# and fill in the values; compose reads .env automatically. Compose passes
# SESSION_SECRET, SIGNING_KEY_PATH and APP_ENV above to the api; DATABASE_URL above is
# ignored by compose: the containers build it from POSTGRES_PASSWORD.
# POSTGRES_PASSWORD: password of the `sketch2cad` database role; use URL-safe
# characters only (for example `openssl rand -hex 24`), since it goes into DATABASE_URL.
POSTGRES_PASSWORD=
# WEB_PORT: host port for the web service on 127.0.0.1 (empty = 18080).
WEB_PORT=
